{
  "name": "bb-plugin-liquid-glass",
  "version": "0.5.4",
  "type": "module",
  "license": "MIT",
  "engines": {
    "bb": ">=0.41",
    "bbPluginSdk": ">=0.4.8"
  },
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs && vitest run",
    "check": "npm run typecheck && npm test"
  },
  "bb": {
    "name": "Liquid Glass",
    "description": "monocode's translucent window inside bb: a wallpaper layer under genuinely frosted panes, with pickable vibrant accents, shell tint, opacity, and blur.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [],
    "themes": [
      {
        "id": "liquid-glass",
        "name": "Liquid Glass",
        "description": "Dark glass shell over a vibrant wallpaper layer, with a pickable accent.",
        "css": "./themes/liquid-glass.css",
        "codeTheme": {
          "dark": "./themes/liquid-glass-dark-code.json",
          "light": "./themes/liquid-glass-dark-code.json"
        }
      },
      {
        "id": "liquid-glass-light",
        "name": "Liquid Glass Light",
        "description": "Pale glass shell over the same wallpaper layer, with a deeper accent.",
        "css": "./themes/liquid-glass-light.css",
        "codeTheme": {
          "dark": "./themes/liquid-glass-light-code.json",
          "light": "./themes/liquid-glass-light-code.json"
        }
      }
    ]
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.34",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.0",
    "hono": "^4.11.9",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^3.0.0"
  }
}
